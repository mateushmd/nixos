{
    "layer": "top",
    "margin-top": 5,
    "margin-left": 10,
    "margin-right": 10,
    "margin-bottom": 5,
    "modules-left": ["hyprland/workspaces", "hyprland/mode"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "backlight", "bluetooth", "network", "battery"],
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "[*]",
            "default": "[ ]",
        },
    },
    "clock": {
        "format-alt": "{:%a, %d. %b  %H:%M}",
    },
    "pulseaudio": {
        "format": "[vol: {volume}%]",
        "format-muted": "[vol: off]",
        "on-click": "pavucontrol",
        "tooltip": false,
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "[bl: {percent}%]"
    },
    "bluetooth": {
        "format": "[bt: {status}]",
        "format-on": "[bt: on]",
        "format-off": "[bt: off]", 
        "format-connected":"[bt: {device_enumerate}]",
        "format-disabled": "[bt: off]",
        "on-click": "blueman-manager",
    },
    "network": {
        "format-wifi": "[net: wifi]",
        "format-ethernet": "[net: eth]",
        "format-disconected": "[net: off]",
        "interval": 5,
        "on-click": "kitty --class \"nmtui\" nmtui",
        "tooltip": false,
    },
    "battery": {
        "format": "[pow: {capacity}%]",
    }
}
